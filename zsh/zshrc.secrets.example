# Example ~/.zshrc.secrets -- copy to ~/.zshrc.secrets, fill in real values,
# then lock it down: chmod 600 ~/.zshrc.secrets
#
# Sourced last by zsh/zshrc, after ~/.zshrc.local. NOT tracked by this repo
# (it lives outside zsh/, in your home directory) -- nothing in here can
# end up in a commit by accident. Keep it to actual credentials/tokens;
# everything else belongs in ~/.zshrc.local instead.

# --- GitHub Packages / private repo (Gradle + Maven) ---
# One token, kept in one place, used by both build tools instead of
# copy-pasting it into gradle.properties and settings.xml separately:
#   - Gradle: GRADLE_OPTS below passes it as JVM system properties
#     (build.gradle[.kts] typically reads them as gpr.user/gpr.token
#     project properties)
#   - Maven: referenced from ~/.m2/settings.xml via ${env.GPR_USER} /
#     ${env.GPR_TOKEN} interpolation -- see maven/settings.xml.example.
#     No MAVEN_OPTS needed; settings.xml reads the env vars directly.
# export GPR_USER="your-username"
# export GPR_TOKEN="ghp_xxx"
# export GRADLE_OPTS="-Dgpr.user=$GPR_USER -Dgpr.token=$GPR_TOKEN"

# --- Sentry ---
# export SENTRY_AUTH_TOKEN="sntrys_xxx"
# export SENTRY_ORG="your-org"
# export SENTRY_PROJECT="your-project"

# --- npm (private registry / scoped packages) ---
# export NPM_TOKEN="npm_xxx"

# --- generic API keys ---
# export OPENAI_API_KEY="sk-xxx"
# export ANTHROPIC_API_KEY="sk-ant-xxx"
