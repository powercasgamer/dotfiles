# Example ~/.zshrc.secrets -- copy to ~/.zshrc.secrets, fill in real values,
# then lock it down: chmod 600 ~/.zshrc.secrets
#
# Sourced last by zsh/zshrc, after ~/.zshrc.local. NOT tracked by this repo
# (it lives outside zsh/, in your home directory) -- nothing in here can
# end up in a commit by accident. Keep it to actual credentials/tokens;
# everything else belongs in ~/.zshrc.local instead.

# --- Gradle (GitHub Packages / private Maven repo) ---
# export GRADLE_OPTS="-Dgpr.user=your-username -Dgpr.token=ghp_xxx"
# (alternatively, Gradle's own convention: put gpr.user/gpr.token in
# ~/.gradle/gradle.properties instead of here)

# --- Maven (GitHub Packages / private Maven repo) ---
# export MAVEN_OPTS="-Dgpr.user=your-username -Dgpr.token=ghp_xxx"
# (alternatively, Maven's own convention: put <server> credentials in
# ~/.m2/settings.xml instead of here)

# --- Sentry ---
# export SENTRY_AUTH_TOKEN="sntrys_xxx"
# export SENTRY_ORG="your-org"
# export SENTRY_PROJECT="your-project"

# --- npm (private registry / scoped packages) ---
# export NPM_TOKEN="npm_xxx"

# --- generic API keys ---
# export OPENAI_API_KEY="sk-xxx"
# export ANTHROPIC_API_KEY="sk-ant-xxx"
