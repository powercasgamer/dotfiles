# ~/dotfiles/zsh/zshrc
# Symlinked to ~/.zshrc by dotfiles/install.sh — keep machine-specific stuff out of this file.

export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="agnoster"

# Plugins:
#   git                   - git aliases/status in prompt info
#   sudo                  - press Esc twice to prepend sudo to the current/previous command
#   command-not-found     - suggests the apt package that provides a missing command
#   colored-man-pages     - adds color to man pages
#   extract               - `x <archive>` to unpack (almost) anything
#   z                     - `z <partial-dir-name>` jumps to frecent directories
#   zsh-completions       - extra completion definitions
#   zsh-autosuggestions   - fish-style suggestions from history as you type (-> right arrow to accept)
#   zsh-syntax-highlighting - must stay last: colors commands green/red as valid/invalid
plugins=(
  git
  sudo
  command-not-found
  extract
  z
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source "$ZSH/oh-my-zsh.sh"

# --- custom config: exports, functions, aliases ---
# Loaded recursively so any *.zsh file, at any nesting depth, gets picked up —
# e.g. aliases/git/aliases.zsh, aliases/work/docker.zsh, exports/core/exports.zsh.
# (N) = nullglob: don't error if a category has no files yet.
for file in "$HOME"/dotfiles/zsh/{exports,functions,aliases}/**/*.zsh(N); do
  source "$file"
done

# --- machine-local overrides (not tracked, safe for host-specific tweaks) ---
[ -r "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"

# --- secrets / auth tokens (not tracked; kept separate from .local so it's
# obvious what's sensitive and easy to chmod 600 on its own) ---
[ -r "$HOME/.zshrc.secrets" ] && source "$HOME/.zshrc.secrets"
