# Example ~/.gradle/gradle.properties -- copy to ~/.gradle/gradle.properties
# (mkdir -p ~/.gradle first if it doesn't exist yet). Applies to every
# Gradle project on this machine as a default, unless a project's own
# gradle.properties overrides it.
#
# No credentials belong here -- see the GPR_USER/GPR_TOKEN block in
# zsh/zshrc.secrets.example (used via GRADLE_OPTS) for those instead.

org.gradle.daemon=true
org.gradle.cache=true
org.gradle.caching=true
org.gradle.tooling.parallel=true
org.gradle.parallel=true
org.gradle.configuration-cache=true
org.gradle.configuration-cache.problems=warn
org.gradle.configureondemand=true
# -Xmx: tune to your machine's RAM and workload. UseCompactObjectHeaders
# (Project Lilliput) needs JDK 24+ -- drop it on an older JDK.
org.gradle.jvmargs=-Xmx4048m -Dfile.encoding=UTF-8 -XX:MaxMetaspaceSize=512m -XX:+UseCompactObjectHeaders
# File-system watching off -- turn on (or drop this line, it's true by
# default) unless you have a reason to disable it, e.g. a network/container
# filesystem where watching is unreliable or noisy.
org.gradle.vfs.watch=false
